{
  "name": "ladecompile",
  "private": true,
  "version": "0.1.0",
  "description": "LadeCompile — free, no-login HTML/CSS/JS online compiler. Monorepo for LadeStack.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:editor": "pnpm --filter editor dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:editor": "pnpm --filter editor build",
    "deploy:web": "pnpm --filter web deploy",
    "deploy:editor": "pnpm --filter editor deploy",
    "deploy": "pnpm -r deploy"
  }
}
