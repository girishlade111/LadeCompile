---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const title = "Blog — LadeCompile: Free HTML CSS JS Compiler & OneCompiler Alternative";
const description =
  "Guides, comparisons, and practical how-tos for free online HTML/CSS/JS compilers — no login required. OneCompiler alternatives, live preview tips, and export workflows from LadeCompile by LadeStack.";

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<BaseLayout title={title} description={description} type="website">
  <Header />
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-widest text-indigo-600 dark:text-indigo-400">LADECOMPILE BLOG</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">Notes on free, no-login editing</h1>
      <p class="mt-3 text-sm leading-6 text-zinc-600 sm:text-base dark:text-zinc-400">
        Practical articles about the <span class="font-semibold text-zinc-900 dark:text-white">free HTML CSS JS compiler</span> landscape, OneCompiler comparisons, and the internals that make a fast <span class="font-semibold text-zinc-900 dark:text-white">online HTML editor with no login</span> possible — all hand-written, no lorem ipsum.
      </p>
      <div class="mt-6 flex justify-center gap-2">
        <a href="/" class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200">← Home</a>
        <a href="/editor" class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Open Editor</a>
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      {posts.length === 0 ? (
        <p class="rounded-xl border border-zinc-200 bg-zinc-50 p-8 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">No posts yet — check back soon.</p>
      ) : (
        <div class="grid gap-4">
          {posts.map((post) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-6 transition hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500">
                <time datetime={post.data.publishDate.toISOString()} class="font-medium">{formatDate(post.data.publishDate)}</time>
                {post.data.updatedDate && (
                  <span class="text-zinc-400">· Updated {formatDate(post.data.updatedDate)}</span>
                )}
                <span class="hidden sm:inline">·</span>
                <span class="inline-flex items-center gap-1.5">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold tracking-wide text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{tag}</span>
                  ))}
                </span>
              </div>
              <h2 class="mt-3 text-lg font-bold leading-6 text-zinc-900 hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
              <a href={`/blog/${post.slug}/`} class="mt-4 inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300">
                Read article
                <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </article>
          ))}
        </div>
      )}
      <div class="mt-8 rounded-xl border border-zinc-200 bg-zinc-50 p-4 text-xs leading-5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
        All posts are Markdown files in <code class="rounded bg-white px-1 py-0.5 dark:bg-zinc-800">src/content/blog/</code> — no CMS, just git. Sitemap and <code class="rounded bg-white px-1 py-0.5 dark:bg-zinc-800">llms.txt</code> pick up new posts automatically on build.
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
