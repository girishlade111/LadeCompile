---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = `${post.data.title} | LadeCompile Blog`;
const description = post.data.description;
const canonical = new URL(`/blog/${post.slug}/`, Astro.site).href;
const image = post.data.heroImage ?? "/favicon.svg";
const editorUrl = import.meta.env.PUBLIC_EDITOR_URL || (import.meta.env.DEV ? "http://localhost:3000/editor" : "/editor");

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { "@type": "Organization", name: "LadeStack" },
  publisher: { "@type": "Organization", name: "LadeCompile", logo: { "@type": "ImageObject", url: new URL("/favicon.svg", Astro.site).href } },
  mainEntityOfPage: canonical,
};
---

<BaseLayout title={title} description={description} canonical={canonical} image={image} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />
  <main id="main-content" class="mx-auto max-w-[1280px] px-6 py-12 lg:px-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <a href="/blog" class="inline-flex items-center text-[14px] font-medium text-[#181d26] hover:text-[#1b61c9] transition-colors">
        <svg class="mr-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to all articles
      </a>

      <article class="mt-8">
        <div class="flex flex-wrap items-center gap-2 text-[12px] text-[#41454d]">
          <time datetime={post.data.publishDate.toISOString()} class="font-medium text-[#181d26]">{formatDate(post.data.publishDate)}</time>
          {post.data.updatedDate && (
            <span>· Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>
          )}
          <span class="hidden sm:inline">·</span>
          <span class="inline-flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="rounded-[6px] border border-[#dddddd] bg-[#f8fafc] px-2 py-0.5 text-[11px] font-medium text-[#41454d]">{tag}</span>
            ))}
          </span>
        </div>

        <h1 class="mt-4 text-[30px] sm:text-[38px] font-normal leading-[1.2] tracking-tight text-[#181d26]">{post.data.title}</h1>
        <p class="mt-4 text-[16px] leading-relaxed text-[#333840]">{post.data.description}</p>

        <div
          class="prose prose-zinc mt-10 max-w-none prose-headings:text-[#181d26] prose-headings:font-normal prose-h2:text-[24px] prose-h2:mt-10 prose-h3:text-[18px] prose-p:text-[#333840] prose-p:leading-relaxed prose-a:text-[#1b61c9] prose-a:font-medium hover:prose-a:underline prose-code:rounded-[6px] prose-code:bg-[#f8fafc] prose-code:border prose-code:border-[#dddddd] prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[13px] prose-code:font-mono prose-code:text-[#181d26] prose-code:before:content-none prose-code:after:content-none prose-pre:overflow-x-auto prose-pre:rounded-[10px] prose-pre:border prose-pre:border-[#dddddd] prose-pre:bg-[#181d26] prose-pre:p-5"
        >
          <Content />
        </div>

        <div class="mt-12 rounded-[10px] border border-[#dddddd] bg-[#f5e9d4] p-6 sm:p-7 text-[14px] leading-relaxed text-[#181d26]">
          <h3 class="text-[16px] font-medium text-[#181d26]">Try it live without an account</h3>
          <p class="mt-1 text-[#333840]">
            Ready to test the snippet above? <a href={editorUrl} class="font-medium text-[#181d26] underline hover:text-[#000000]">Open the free LadeCompile editor</a> — no login, no paywall, just instant code. Part of the <a href="https://ladestack.in" class="font-medium text-[#181d26] underline hover:text-[#000000]">LadeStack</a> open developer suite.
          </p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
