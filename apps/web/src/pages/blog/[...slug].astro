---
export const prerender = true;
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { filterPublishedPosts, getPostSlug, getPostLocale } from "../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = filterPublishedPosts(allPosts, false);

  // Deduplicate: only first occurrence per (locale, slug) wins
  const seen = new Set<string>();
  const deduped = publishedPosts.filter((post) => {
    const locale = getPostLocale(post);
    const slug = getPostSlug(post);
    const key = `${locale}:${slug}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });

  // For English-only content, generate static paths for every locale so /zh/blog/slug etc
  // do not 404 — they will render the English post with a translation-pending notice (better UX than 404).
  // This also ensures LanguageSwitcher locale swaps on blog posts stay on the same slug instead of 404.
  const SUPPORTED = ["en", "zh", "pt-br", "ru", "ja", "tr", "ko"] as const;
  const paths: Array<{ params: { slug: string }; props: { post: typeof deduped[number]; allPosts: typeof deduped; locale: string } }> = [];
  for (const post of deduped) {
    // Only English posts need cross-locale fallback; non-English already have their own locale
    if (getPostLocale(post) === "en") {
      for (const loc of SUPPORTED) {
        paths.push({ params: { slug: getPostSlug(post) }, props: { post, allPosts: deduped, locale: loc } });
      }
    } else {
      paths.push({ params: { slug: getPostSlug(post) }, props: { post, allPosts: deduped, locale: getPostLocale(post) } });
    }
  }
  // Deduplicate paths by (locale, slug) to avoid duplicate generation for same locale+slug
  const seenPaths = new Set<string>();
  return paths.filter((p) => {
    const key = `${p.props.locale}:${p.params.slug}`;
    if (seenPaths.has(key)) return false;
    seenPaths.add(key);
    return true;
  });
}

const { post, allPosts, locale: staticLocale } = Astro.props as { post: any; allPosts: any[]; locale: string };
const currentLocale = (Astro.currentLocale as string) ?? staticLocale ?? getPostLocale(post) ?? "en";
const postLocale = getPostLocale(post);
const isFallback = currentLocale.toLowerCase() !== postLocale.toLowerCase() && postLocale === "en";
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} headings={headings} allPosts={allPosts}>
  <Content />
</BlogPostLayout>
