---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "LadeCompile — Free HTML CSS JS Compiler, No Login Required | OneCompiler Alternative";
const description =
  "LadeCompile is a free, no-login, enterprise-grade HTML/CSS/JS online compiler and live editor. Write, preview, and share code instantly — no signup, no paywall. Fast, private OneCompiler alternative from LadeStack.";
---

<BaseLayout title={title} description={description} type="website">
  <!-- Header / Nav -->
  <header class="sticky top-0 z-40 w-full border-b border-zinc-200/60 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70 dark:border-zinc-800 dark:bg-zinc-950/70">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="LadeCompile home">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-indigo-600 text-[11px] font-extrabold tracking-widest text-white">LC</span>
        <span class="text-sm font-bold tracking-tight">LadeCompile</span>
        <span class="hidden rounded-full border border-zinc-200 px-2 py-0.5 text-[10px] font-semibold tracking-widest text-zinc-500 sm:inline-flex dark:border-zinc-800">LADESTACK</span>
      </a>
      <nav class="flex items-center gap-1 sm:gap-2" aria-label="Primary">
        <a href="/blog" class="rounded-full px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white">Blog</a>
        <a href="/editor" class="inline-flex items-center rounded-full bg-zinc-900 px-4 py-1.5 text-sm font-semibold text-white hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100">Open Editor</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden" aria-labelledby="hero-heading">
      <!-- subtle grid / glow -->
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,theme(colors.zinc.100)_1px,transparent_1px),linear-gradient(to_bottom,theme(colors.zinc.100)_1px,transparent_1px)] bg-[size:32px_32px] opacity-[0.45] dark:bg-[linear-gradient(to_right,theme(colors.zinc.900)_1px,transparent_1px),linear-gradient(to_bottom,theme(colors.zinc.900)_1px,transparent_1px)]"></div>
      <div class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-[480px] w-[880px] -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl dark:bg-indigo-500/15"></div>

      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 dark:border-indigo-900/50 dark:bg-indigo-950/40 dark:text-indigo-300">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Free · No login · No paywall — ever
            </div>
            <h1 id="hero-heading" class="mt-4 max-w-[18ch] text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl lg:text-[3.25rem] lg:leading-[0.95] dark:text-white">
              Free HTML CSS JS compiler,
              <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">no login required.</span>
            </h1>
            <p class="mt-4 max-w-[55ch] text-base leading-6 text-zinc-600 sm:text-lg dark:text-zinc-400">
              LadeCompile is the fast, enterprise-grade <strong class="font-semibold text-zinc-900 dark:text-white">online HTML editor</strong> for developers, students, and educators. Write HTML, CSS, and JavaScript in one tabbed editor and see your live preview instantly — the clean, <strong class="font-semibold text-zinc-900 dark:text-white">OneCompiler alternative</strong> without the signup wall.
            </p>
            <p class="mt-3 max-w-[55ch] text-sm leading-6 text-zinc-500 dark:text-zinc-500">
              Part of the LadeStack suite of free, no-login developer tools. Build a landing page, debug a layout bug, or prototype a component in seconds.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a
                href="/editor"
                class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
              >
                Open Editor — it’s free
                <svg class="ml-2 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="#features" class="inline-flex items-center justify-center rounded-full border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800">See how it works</a>
            </div>
            <p class="mt-3 text-xs text-zinc-500">No account needed to save or share. Works in your browser.</p>

            <div class="mt-8 flex flex-wrap items-center gap-4 text-xs text-zinc-500">
              <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 16 16" fill="none"><path d="M4 8.2L7 11L12 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> No signup to save & share</span>
              <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 16 16" fill="none"><path d="M4 8.2L7 11L12 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> No paywalled features</span>
              <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 16 16" fill="none"><path d="M4 8.2L7 11L12 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Live preview</span>
            </div>
          </div>

          <!-- Code preview mock (visual only, not the real editor — that lives at /editor) -->
          <div class="relative">
            <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-xl dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex items-center justify-between border-b border-zinc-200 bg-zinc-50 px-3 py-2 dark:border-zinc-800 dark:bg-zinc-900">
                <div class="flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded-full bg-red-400"></span><span class="h-3 w-3 rounded-full bg-amber-400"></span><span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                </div>
                <div class="flex items-center gap-1 text-[11px] font-medium">
                  <span class="rounded bg-white px-2 py-1 text-zinc-700 shadow-sm ring-1 ring-zinc-200 dark:bg-zinc-800 dark:text-zinc-200 dark:ring-zinc-700">index.html</span>
                  <span class="px-2 py-1 text-zinc-500">styles.css</span>
                  <span class="px-2 py-1 text-zinc-500">script.js</span>
                </div>
                <span class="text-[11px] font-semibold text-zinc-500">Preview</span>
              </div>
              <div class="grid gap-0 lg:grid-cols-2">
                <pre class="overflow-x-auto p-4 text-[11px] leading-5 text-zinc-700 dark:text-zinc-300"><code><span class="text-zinc-400">&lt;!-- free HTML CSS JS compiler --&gt;</span>
<span class="text-indigo-600">&lt;section</span> <span class="text-sky-600">class</span>=<span class="text-emerald-600">"hero"</span><span class="text-indigo-600">&gt;</span>
  <span class="text-indigo-600">&lt;h1&gt;</span>Hello, LadeCompile<span class="text-indigo-600">&lt;/h1&gt;</span>
  <span class="text-indigo-600">&lt;p&gt;</span>No login. Just code.<span class="text-indigo-600">&lt;/p&gt;</span>
  <span class="text-indigo-600">&lt;button</span> <span class="text-sky-600">id</span>=<span class="text-emerald-600">"run"</span><span class="text-indigo-600">&gt;</span>Run<span class="text-indigo-600">&lt;/button&gt;</span>
<span class="text-indigo-600">&lt;/section&gt;</span></code></pre>
                <div class="border-t border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-950">
                  <div class="rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
                    <h2 class="text-sm font-bold text-zinc-900 dark:text-white">Hello, LadeCompile</h2>
                    <p class="mt-1 text-xs text-zinc-500">No login. Just code.</p>
                    <button class="mt-3 rounded-full bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white">Run</button>
                  </div>
                  <p class="mt-3 text-center text-[11px] text-zinc-500">Live preview updates as you type — sandboxed, instant.</p>
                </div>
              </div>
              <div class="border-t border-zinc-200 bg-white px-3 py-2 text-[11px] text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">
                Console · <span class="text-emerald-600">Ready</span> — 0 errors
              </div>
            </div>
            <p class="mt-3 text-center text-xs text-zinc-500">Preview is live in the <a href="/editor" class="font-semibold text-indigo-600 underline decoration-indigo-200 underline-offset-4 hover:text-indigo-700">editor</a>. This is just a homepage snapshot.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature highlights -->
    <section id="features" class="border-y border-zinc-200 bg-zinc-50/60 py-12 sm:py-16 dark:border-zinc-800 dark:bg-zinc-900/40" aria-labelledby="features-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-white">Everything you need — nothing gated.</h2>
          <p class="mt-3 text-sm leading-6 text-zinc-600 sm:text-base dark:text-zinc-400">
            A focused <span class="font-semibold text-zinc-900 dark:text-white">free HTML CSS JS compiler</span> that keeps the core fast and removes every friction point: no account, no upgrade prompt, no feature lock.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <!-- 1 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-zinc-900 dark:text-white">Live preview, instantly</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Three-file tabbed editor (HTML / CSS / JS) with debounced, sandboxed iframe preview. Invalid markup still renders what it can; JS errors surface in the console, not as a crash.</p>
          </article>
          <!-- 2 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950 dark:text-emerald-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M13.5 6.5L17.5 10.5M10 13L15.5 7.5A2.12 2.12 0 0 1 18.5 10.5L13 16L10.5 16.5L11 14L13.5 6.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-zinc-900 dark:text-white">Save & share without an account</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">State is compressed into the URL — copy a link and anyone sees the same code. For large snippets, we switch transparently to a short link. No login to create or open shares.</p>
          </article>
          <!-- 3 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950 dark:text-amber-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 16V3M12 16L8 12M12 16L16 12M4 19H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-zinc-900 dark:text-white">Instant export — ZIP, copy, screenshot</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Download your three files as a ZIP, copy code to clipboard, or capture the preview as PNG/JPEG — all client-side, no server round-trip. Take your work anywhere.</p>
          </article>
          <!-- 4 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-50 text-sky-600 dark:bg-sky-950 dark:text-sky-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 9H16M8 12H14M8 15H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-zinc-900 dark:text-white">Templates library</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Start from a landing page, portfolio, or form boilerplate in one click. Searchable, categorized starters that replace cleanly — with a confirm if you have unsaved changes.</p>
          </article>
          <!-- 5 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 8V12L14.5 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-zinc-900 dark:text-white">Dark & light themes</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">One-click toggle, Monaco theme in sync, preference persisted in localStorage and respects <code class="rounded bg-zinc-100 px-1 py-0.5 text-xs dark:bg-zinc-800">prefers-color-scheme</code> on first visit.</p>
          </article>
          <!-- 6 -->
          <article class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-950 dark:text-violet-300" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M12 16C14.2 16 16 14.2 16 12C16 9.8 14.2 8 12 8C9.8 8 8 9.8 8 12C8 14.2 9.8 16 12 16Z" stroke="currentColor" stroke-width="1.6"/><path d="M12 8V6M12 18V16M8 12H6M18 12H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-semibold text-zinc-900 dark:text-white">AI-assisted code help</h3>
              <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold tracking-widest text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">COMING SOON</span>
            </div>
            <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Explain, find bugs, add comments, optimize, and review — planned as free, no-paywall actions. Not live in this build; shown as a roadmap item so the homepage stays honest.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section class="py-12 sm:py-16" aria-labelledby="compare-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-bold tracking-widest text-indigo-600 dark:text-indigo-400">WHY LADECOMPILE</p>
          <h2 id="compare-heading" class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-white">A free OneCompiler alternative — without the asterisks.</h2>
          <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">OneCompiler is a capable online editor. The difference is the business model: LadeCompile keeps the same core editing experience but never gates it behind a login or an Upgrade plan.</p>
        </div>

        <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800">
          <div class="grid grid-cols-[1.2fr_0.9fr_0.9fr] gap-px bg-zinc-200 dark:bg-zinc-800">
            <!-- header row -->
            <div class="bg-zinc-50 px-4 py-3 text-xs font-semibold tracking-widest text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">CAPABILITY</div>
            <div class="bg-indigo-600 px-4 py-3 text-center text-xs font-bold tracking-widest text-white">LADECOMPILE</div>
            <div class="bg-zinc-50 px-4 py-3 text-center text-xs font-semibold tracking-widest text-zinc-500 dark:bg-zinc-900">ONECOMPILER*</div>

            <!-- rows -->
            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">Save & share without login</div>
            <div class="bg-white px-4 py-4 text-center text-sm dark:bg-zinc-950"><span class="inline-flex items-center gap-1 font-semibold text-emerald-600"><svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M4 8.2L7 11L12 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Free</span><div class="text-xs text-zinc-500">URL or short link, no account</div></div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Login required for saved shares</div>

            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">Paywalled features</div>
            <div class="bg-white px-4 py-4 text-center text-sm font-semibold text-emerald-600 dark:bg-zinc-950">None — all free</div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">AI Agent behind Upgrade</div>

            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">Live preview & console</div>
            <div class="bg-white px-4 py-4 text-center text-sm font-semibold text-emerald-600 dark:bg-zinc-950">Included</div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Included</div>

            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">Export (ZIP / copy / screenshot)</div>
            <div class="bg-white px-4 py-4 text-center text-sm dark:bg-zinc-950"><span class="font-semibold text-emerald-600">Free</span><div class="text-xs text-zinc-500">Client-side, instant</div></div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Included</div>

            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">AI code help</div>
            <div class="bg-white px-4 py-4 text-center text-sm dark:bg-zinc-950"><span class="inline-flex items-center gap-2 font-semibold text-zinc-700 dark:text-zinc-200">Free when launched <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] leading-none tracking-widest text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">SOON</span></span><div class="text-xs text-zinc-500">Explain / bugs / optimize / review — no paywall</div></div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Behind Upgrade</div>

            <div class="bg-white px-4 py-4 text-sm font-medium text-zinc-900 dark:bg-zinc-950 dark:text-white">Privacy</div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Local-first; share is explicit via link</div>
            <div class="bg-white px-4 py-4 text-center text-sm text-zinc-600 dark:bg-zinc-950 dark:text-zinc-400">Account-based saves</div>
          </div>
          <p class="bg-zinc-50 px-4 py-2.5 text-center text-xs leading-5 text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">*Comparison based on publicly available OneCompiler pricing/flow as of Aug 2026. OneCompiler remains a strong product — this table only highlights where LadeCompile removes login/paywall friction.</p>
        </div>

        <div class="mx-auto mt-6 flex max-w-3xl items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900 dark:border-amber-900/40 dark:bg-amber-950/30 dark:text-amber-100">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9V13M12 17H12.01M12 21C16.97 21 21 16.97 21 12C21 7.03 16.97 3 12 3C7.03 3 3 7.03 3 12C3 16.97 7.03 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <p><strong>Honesty note:</strong> AI-assisted actions are <em>not live yet</em> in this build. They’re on the roadmap as free, no-login features — we mark them “Coming soon” everywhere so the homepage never overpromises. Today’s editor already covers the core: three-file editing, live preview, console, templates, save/share, export, and theming.</p>
        </div>

        <div class="mt-8 text-center">
          <a href="/editor" class="inline-flex items-center justify-center rounded-full bg-zinc-900 px-6 py-3 text-sm font-semibold text-white hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100">Try the editor — no signup</a>
          <p class="mt-2 text-xs text-zinc-500">Takes you to <code class="rounded bg-zinc-100 px-1.5 py-0.5 dark:bg-zinc-800">/editor</code> (Next.js app). If the route isn’t built yet, a 404 is expected during scaffold.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
