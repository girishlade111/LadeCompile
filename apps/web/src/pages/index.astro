---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "LadeCompile — Free Online HTML CSS JS Compiler, No Login Required";
const description =
  "LadeCompile is a free, no-login online HTML/CSS/JS compiler and live editor with instant sandboxed preview, console bridge, ZIP export, and zero-storage sharing. Fast, private OneCompiler alternative from LadeStack.";

const editorUrl = import.meta.env.PUBLIC_EDITOR_URL || (import.meta.env.DEV ? "http://localhost:3000/editor" : "/editor");
---

<BaseLayout title={title} description={description} type="website">
  <Header />

  <main id="main-content" class="bg-[#ffffff]">
    <!-- Hero Band: Pure white canvas, 96px vertical padding, Haas/Inter typography, signature button pair -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="hero-heading">
      <div class="relative z-10 mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <!-- Clean kicker pill -->
            <div class="inline-flex items-center gap-2 rounded-full border border-[#dddddd] bg-[#f8fafc] px-3.5 py-1 text-[13px] font-medium text-[#181d26]">
              <span class="h-2 w-2 rounded-full bg-[#006400]"></span>
              Free · No login · No paywall — ever
            </div>

            <!-- Display LG Headline: weight 400/500, never overly bold -->
            <h1 id="hero-heading" class="mt-5 text-[36px] sm:text-[46px] lg:text-[50px] font-normal leading-[1.12] tracking-tight text-[#181d26]">
              Free HTML, CSS & JS compiler, <br class="hidden sm:inline" />
              <span class="text-[#181d26] font-medium">no login required.</span>
            </h1>

            <p class="mt-5 max-w-[54ch] text-[16px] leading-[1.5] text-[#333840]">
              LadeCompile is the quiet, enterprise-grade <strong class="font-medium text-[#181d26]">online code compiler</strong> for developers, students, and educators. Write HTML, CSS, and JavaScript in one tabbed editor and see your sandboxed live preview instantly — the clean <strong class="font-medium text-[#181d26]">OneCompiler alternative</strong> without the signup wall.
            </p>

            <p class="mt-3 max-w-[54ch] text-[14px] leading-relaxed text-[#41454d]">
              Part of the LadeStack suite of free developer tools. Prototype responsive layouts, debug JavaScript logic, or export standalone files in seconds.
            </p>

            <!-- Signature Button Pair -->
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a href={editorUrl} class="btn-primary">
                Open Web Editor — it’s free
                <svg class="ml-2.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="#starters" class="btn-secondary">
                Explore Starter Templates
              </a>
            </div>

            <p class="mt-3 text-[13px] text-[#41454d]">No account needed to write, save, or share. Local-first execution in your browser.</p>

            <!-- Trust Points -->
            <div class="mt-8 flex flex-wrap items-center gap-6 text-[13px] text-[#333840] border-t border-[#dddddd] pt-6">
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#006400]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Zero-Login URL Sharing
              </span>
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#006400]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                400ms Debounced Preview
              </span>
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#006400]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Client-Side ZIP Export
              </span>
            </div>
          </div>

          <!-- Code Snapshot Frame (Airtable-style clean editorial mockup) -->
          <div class="relative">
            <div class="overflow-hidden rounded-[12px] border border-[#dddddd] bg-[#ffffff] shadow-sm">
              <!-- Window header -->
              <div class="flex items-center justify-between border-b border-[#dddddd] bg-[#f8fafc] px-4 py-2.5">
                <div class="flex items-center gap-2">
                  <span class="h-3 w-3 rounded-full bg-[#e0e2e6] border border-[#dddddd]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#e0e2e6] border border-[#dddddd]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#e0e2e6] border border-[#dddddd]"></span>
                </div>
                <div class="flex items-center gap-1.5 text-[12px]">
                  <span class="rounded-[6px] bg-[#ffffff] px-2.5 py-1 font-medium text-[#181d26] border border-[#dddddd]">index.html</span>
                  <span class="px-2 py-1 text-[#41454d]">styles.css</span>
                  <span class="px-2 py-1 text-[#41454d]">script.js</span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] font-medium text-[#41454d]">
                  <span class="h-2 w-2 rounded-full bg-[#006400]"></span> Live
                </div>
              </div>

              <!-- Editor & Preview Split -->
              <div class="grid gap-0 sm:grid-cols-2">
                <pre class="overflow-x-auto bg-[#ffffff] p-4 text-[12px] leading-relaxed text-[#333840] font-mono border-b sm:border-b-0 sm:border-r border-[#dddddd]"><code><span class="text-[#41454d]">&lt;!-- LadeCompile Live --&gt;</span>
<span class="text-[#1b61c9]">&lt;div</span> <span class="text-[#aa2d00]">class</span>=<span class="text-[#006400]">"card"</span><span class="text-[#1b61c9]">&gt;</span>
  <span class="text-[#1b61c9]">&lt;h2&gt;</span>Fast Prototyping<span class="text-[#1b61c9]">&lt;/h2&gt;</span>
  <span class="text-[#1b61c9]">&lt;p&gt;</span>Zero login. 400ms compile.<span class="text-[#1b61c9]">&lt;/p&gt;</span>
  <span class="text-[#1b61c9]">&lt;button</span> <span class="text-[#aa2d00]">id</span>=<span class="text-[#006400]">"action"</span><span class="text-[#1b61c9]">&gt;</span>
    Run Component
  <span class="text-[#1b61c9]">&lt;/button&gt;</span>
<span class="text-[#1b61c9]">&lt;/div&gt;</span></code></pre>

                <div class="bg-[#f8fafc] p-4 flex flex-col justify-between">
                  <div class="rounded-[10px] border border-[#dddddd] bg-[#ffffff] p-4">
                    <h3 class="text-[15px] font-medium text-[#181d26]">Fast Prototyping</h3>
                    <p class="mt-1 text-[13px] text-[#41454d]">Zero login. 400ms compile.</p>
                    <button class="mt-3 inline-flex items-center justify-center rounded-[6px] bg-[#181d26] px-3 py-1.5 text-[12px] font-medium text-white shadow-xs">
                      Run Component
                    </button>
                  </div>
                  <p class="mt-3 text-center text-[11px] text-[#41454d]">Sandboxed preview rendered at 60fps</p>
                </div>
              </div>

              <!-- Console status footer -->
              <div class="flex items-center justify-between border-t border-[#dddddd] bg-[#ffffff] px-4 py-2 text-[12px] text-[#41454d]">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-[#181d26]">Console:</span>
                  <span class="text-[#006400] font-medium">Ready</span> — 0 warnings, 0 errors
                </div>
                <span class="text-[11px] text-[#41454d]">PostMessage Bridge Active</span>
              </div>
            </div>
            <p class="mt-3 text-center text-[13px] text-[#41454d]">
              Looking for full Monaco code features? <a href={editorUrl} class="font-medium text-[#1b61c9] hover:underline">Open the complete web editor</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Monochrome Standards & Tech Strip: 32px padding, clean muted typography -->
    <section class="relative isolate overflow-hidden border-y border-[#dddddd] bg-[#ffffff] py-8" aria-label="Supported Standards">
      <div class="relative z-10 mx-auto max-w-[1280px] px-6 lg:px-12">
        <p class="text-center text-[11px] font-semibold uppercase tracking-wider text-[#41454d]">
          Built with open web standards & modern cloud infrastructure
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-8 sm:gap-12 text-[14px] font-medium text-[#333840]">
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            HTML5 Living Standard
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            CSS3 Grid & Flexbox
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            ECMAScript 2024
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            Monaco Engine
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            Sandboxed Iframe
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#181d26]"></span>
            Cloudflare Edge
          </span>
        </div>
      </div>
    </section>

    <!-- Signature Coral Card: The brand voltage section from DESIGN.md -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]">
      <div class="relative z-10 mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="relative isolate overflow-hidden rounded-[12px] bg-[#aa2d00] p-8 sm:p-12 lg:p-14 text-white shadow-sm">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div>
              <span class="inline-flex rounded-[6px] bg-white/20 px-3 py-1 text-[12px] font-medium tracking-wide uppercase text-white backdrop-blur-xs">
                Instant Execution Architecture
              </span>
              <h2 class="mt-4 text-[28px] sm:text-[36px] font-normal leading-[1.2] tracking-tight text-white">
                Zero-login code execution with instant live preview.
              </h2>
              <p class="mt-4 text-[15px] sm:text-[16px] leading-[1.5] text-white/90">
                Stop wasting time registering accounts or hitting paywalls just to test an HTML snippet or experiment with a CSS trick. LadeCompile compiles your three files in a debounced, isolated worker bridge right in your client.
              </p>
              <div class="mt-8 flex flex-wrap items-center gap-4">
                <a href={editorUrl} class="btn-secondary-on-dark">
                  Launch Live Compiler
                  <svg class="ml-2 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Architectural Mockup inside Coral Card -->
            <div class="relative z-10 rounded-[10px] border border-white/20 bg-white/10 p-6 backdrop-blur-sm text-white">
              <div class="flex items-center justify-between border-b border-white/20 pb-3 text-[12px] font-medium">
                <span>Compilation Pipeline</span>
                <span class="rounded bg-white/20 px-2 py-0.5 text-[11px]">400ms Debounce</span>
              </div>
              <div class="mt-4 space-y-3 text-[13px]">
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>1. Client Monaco Inputs (HTML/CSS/JS)</span>
                  <span class="text-white/80">Local-first</span>
                </div>
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>2. Sandbox Iframe PostMessage Bridge</span>
                  <span class="text-white/80">Isolated Origin</span>
                </div>
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>3. Zero-Storage URL Hash Compression</span>
                  <span class="text-white/80">LZ-String</span>
                </div>
              </div>
              <p class="mt-4 text-[12px] text-white/80 text-center">
                High reliability · Zero tracking · Unblocked performance
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Demo-Card Grid (Pastel & Signature Surfaces): Mint, Peach, Forest, Cream -->
    <section id="features" class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="demo-grid-heading">
      <div class="relative z-10 mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="max-w-2xl">
          <p class="text-[13px] font-semibold uppercase tracking-wider text-[#aa2d00]">Engineered For Flow</p>
          <h2 id="demo-grid-heading" class="mt-2 text-[28px] sm:text-[36px] font-normal leading-[1.2] tracking-tight text-[#181d26]">
            Every feature you need — none of the paywalls.
          </h2>
          <p class="mt-3 text-[16px] leading-[1.5] text-[#333840]">
            A focused developer workbench that eliminates the friction of traditional web playgrounds.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1: Mint Surface (#a8d8c4) -->
          <article class="rounded-[10px] bg-[#a8d8c4] p-6 text-[#181d26] flex flex-col justify-between shadow-xs">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#181d26]/70">Zero-Storage Sharing</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#181d26]">Instant State Compression</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#181d26]/90">
                Your code is compressed straight into the browser URL hash using LZ-String. Share snippets with colleagues without creating an account or sending data to a database.
              </p>
            </div>
            <div class="mt-6 rounded-[8px] border border-[#181d26]/15 bg-white/70 p-3 text-[12px] font-mono text-[#181d26]">
              compile.ladestack.in/#code=H4sIAAAAAAA...
            </div>
          </article>

          <!-- Card 2: Peach Surface (#fcab79) -->
          <article class="rounded-[10px] bg-[#fcab79] p-6 text-[#181d26] flex flex-col justify-between shadow-xs">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#181d26]/70">Export Suite</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#181d26]">ZIP, HTML & Screenshot</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#181d26]/90">
                Download your HTML, CSS, and JS bundle as a ready-to-deploy ZIP, copy standalone single-file HTML, or snap a crisp high-res screenshot of your rendered UI.
              </p>
            </div>
            <div class="mt-6 flex gap-2">
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#181d26]">.ZIP</span>
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#181d26]">HTML</span>
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#181d26]">PNG</span>
            </div>
          </article>

          <!-- Card 3: Forest Signature Card (#0a2e0e) -->
          <article class="relative isolate overflow-hidden rounded-[12px] bg-[#0a2e0e] p-6 text-white flex flex-col justify-between shadow-xs lg:row-span-2">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-white/70">Monaco Engine</span>
              <h3 class="mt-2 text-[22px] font-medium leading-snug text-white">VS Code Precision in Your Browser</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-white/90">
                Built on Monaco Editor, LadeCompile provides native syntax highlighting, intelligent indentation, code formatting, find-and-replace, and native keyboard shortcuts.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Save / Compile</span>
                  <kbd class="rounded bg-white/20 px-1.5 py-0.5 text-[10px] font-mono">Cmd/Ctrl + S</kbd>
                </div>
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Find & Replace</span>
                  <kbd class="rounded bg-white/20 px-1.5 py-0.5 text-[10px] font-mono">Cmd/Ctrl + F</kbd>
                </div>
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Toggle Minimap</span>
                  <span class="text-white/70 text-[11px]">Preferences Menu</span>
                </div>
              </div>
            </div>

            <div class="mt-6 border-t border-white/20 pt-4">
              <a href={editorUrl} class="inline-flex items-center text-[13px] font-medium text-white hover:underline">
                Test in editor →
              </a>
            </div>
          </article>

          <!-- Card 4: Cream Surface (#f5e9d4) -->
          <article class="rounded-[10px] bg-[#f5e9d4] p-6 text-[#181d26] flex flex-col justify-between shadow-xs md:col-span-2 lg:col-span-2">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#181d26]/70">Curated Starters</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#181d26]">10 Production-Grade Starter Boilerplates</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#181d26]/90">
                Start from a blank canvas or choose from verified templates: modern CSS Grid dashboards, responsive landing pages, interactive forms with client validation, dark mode cards, HTML5 canvas animations, and weather API widgets.
              </p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="rounded-[6px] border border-[#181d26]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#181d26]">CSS Grid</span>
              <span class="rounded-[6px] border border-[#181d26]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#181d26]">Flexbox Hero</span>
              <span class="rounded-[6px] border border-[#181d26]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#181d26]">Canvas Animation</span>
              <span class="rounded-[6px] border border-[#181d26]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#181d26]">Fetch API Weather</span>
              <span class="rounded-[6px] border border-[#181d26]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#181d26]">Form Validation</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Tabbed Feature Showcase: feature-card-tabbed from DESIGN.md -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="workflow-heading">
      <div class="relative z-10 mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="max-w-2xl">
          <p class="text-[13px] font-semibold uppercase tracking-wider text-[#1b61c9]">Deliberate Simplicity</p>
          <h2 id="workflow-heading" class="mt-2 text-[28px] sm:text-[36px] font-normal leading-[1.2] tracking-tight text-[#181d26]">
            Engineered for uncluttered focus.
          </h2>
          <p class="mt-3 text-[16px] leading-[1.5] text-[#333840]">
            Explore how each part of LadeCompile fits together to give you a clean, reliable coding workflow.
          </p>
        </div>

        <div class="mt-12 rounded-[12px] border border-[#dddddd] bg-[#f8fafc] p-6 sm:p-10">
          <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-center">
            <!-- Left Tab Navigation -->
            <div class="flex flex-col gap-2" role="tablist" aria-label="Feature Tabs">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                class="tab-btn text-left rounded-[10px] border border-[#dddddd] bg-white p-4 transition-all"
                data-tab="tab-1"
              >
                <div class="text-[16px] font-medium text-[#181d26]">1. Three-File Harmony</div>
                <div class="mt-1 text-[13px] text-[#41454d]">Independent HTML, CSS, and JS tabs with automatic syntax formatting.</div>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="tab-btn text-left rounded-[10px] border border-transparent hover:border-[#dddddd] bg-transparent p-4 transition-all"
                data-tab="tab-2"
              >
                <div class="text-[16px] font-medium text-[#181d26]">2. Sandboxed Console Bridge</div>
                <div class="mt-1 text-[13px] text-[#41454d]">Live postMessage error and log forwarding with unread count badges.</div>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="tab-btn text-left rounded-[10px] border border-transparent hover:border-[#dddddd] bg-transparent p-4 transition-all"
                data-tab="tab-3"
              >
                <div class="text-[16px] font-medium text-[#181d26]">3. Local-First Storage</div>
                <div class="mt-1 text-[13px] text-[#41454d]">Changes persist automatically in localStorage; work survives reloads.</div>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="tab-btn text-left rounded-[10px] border border-transparent hover:border-[#dddddd] bg-transparent p-4 transition-all"
                data-tab="tab-4"
              >
                <div class="text-[16px] font-medium text-[#181d26]">4. Unsaved Work Protection</div>
                <div class="mt-1 text-[13px] text-[#41454d]">Confirmation guards prevent accidental loss when loading starters or resetting.</div>
              </button>
            </div>

            <!-- Right Tab Display Pane -->
            <div class="rounded-[10px] border border-[#dddddd] bg-white p-6 shadow-xs">
              <div id="tab-content" class="min-h-[260px] flex flex-col justify-between">
                <div>
                  <div class="inline-flex items-center gap-2 rounded-[4px] bg-[#f8fafc] border border-[#dddddd] px-2.5 py-1 text-[11px] font-medium text-[#181d26]">
                    Active Capability
                  </div>
                  <h3 id="tab-title" class="mt-3 text-[20px] font-medium text-[#181d26]">
                    Dedicated Tabbed Editor Environment
                  </h3>
                  <p id="tab-desc" class="mt-2 text-[14px] leading-relaxed text-[#333840]">
                    Switch smoothly between <code class="rounded bg-[#f8fafc] px-1 py-0.5 text-[12px] border border-[#dddddd]">index.html</code>, <code class="rounded bg-[#f8fafc] px-1 py-0.5 text-[12px] border border-[#dddddd]">styles.css</code>, and <code class="rounded bg-[#f8fafc] px-1 py-0.5 text-[12px] border border-[#dddddd]">script.js</code> without clutter. Each tab runs full Monaco IntelliSense and error markers.
                  </p>
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-[#dddddd] pt-4 text-[13px]">
                  <span class="text-[#41454d]">Ready to write code?</span>
                  <a href={editorUrl} class="font-medium text-[#1b61c9] hover:underline">
                    Open Editor →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
