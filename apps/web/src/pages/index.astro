<script>
  // Tab switching interaction for Feature Showcase
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabTitle = document.getElementById("tab-title");
  const tabDesc = document.getElementById("tab-desc");

  const tabData: Record<string, { title: string; desc: string }> = {
    "tab-1": {
      title: "Dedicated Tabbed Editor Environment",
      desc: "Switch smoothly between index.html, styles.css, and script.js without clutter. Each tab runs full Monaco IntelliSense and error markers with independent undo history."
    },
    "tab-2": {
      title: "Sandboxed Console Bridge with Live Error Trapping",
      desc: "Console.log, console.warn, and runtime uncaught errors postMessage safely to the UI console drawer with active count badges and instant clear functionality."
    },
    "tab-3": {
      title: "Offline-First Local Storage Persistence",
      desc: "Your three files auto-save to browser localStorage on every edit with a 400ms debounce. Close your tab or reload anytime without fear of losing progress."
    },
    "tab-4": {
      title: "Unsaved Work Protection & Clean Resets",
      desc: "Switching starter templates or resetting the workspace prompts for confirmation whenever you have modified code, ensuring you never accidentally overwrite your work."
    }
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tabKey = btn.getAttribute("data-tab");
      if (!tabKey || !tabData[tabKey]) return;

      // Update button states
      tabButtons.forEach((b) => {
        b.setAttribute("aria-selected", "false");
        b.classList.remove("bg-white", "border-[#dddddd]");
        b.classList.add("bg-transparent", "border-transparent");
      });

      btn.setAttribute("aria-selected", "true");
      btn.classList.remove("bg-transparent", "border-transparent");
      btn.classList.add("bg-white", "border-[#dddddd]");

      // Update content
      if (tabTitle) tabTitle.textContent = tabData[tabKey].title;
      if (tabDesc) tabDesc.textContent = tabData[tabKey].desc;
    });
  });
</script>
