---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUiMessages, t } from "../i18n/index";
import { normalizeLocale } from "../i18n/locales";

// For prerendered i18n routes with output:"static" and prefixDefaultLocale:false,
// Astro automatically generates / (en) and /{locale}/ for others from this single file.
// No getStaticPaths needed — Astro handles locale variants automatically.
// Read locale via Astro.currentLocale (set by i18n routing).
const locale = normalizeLocale((Astro.currentLocale as string) ?? "en");
const ui = await getUiMessages(locale);

const title = t(ui as any, "meta.siteTitle");
const description = t(ui as any, "meta.siteDescription");

const editorUrl = import.meta.env.PUBLIC_EDITOR_URL || (import.meta.env.DEV ? "http://localhost:3000/editor" : "/editor");
---

<BaseLayout title={title} description={description} type="website">
  <Header />

  <main id="main-content" class="bg-[#ffffff]">
    <!-- Hero Band: Pure white canvas, 96px vertical padding, Haas/Inter typography, signature button pair -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="hero-heading">
      <div class="relative z-content mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <!-- Clean kicker pill -->
            <div class="inline-flex items-center gap-2 rounded-full border border-[#d0d7de] bg-[#f6f8fa] px-3.5 py-1 text-[13px] font-medium text-[#24292f]">
              <span class="h-2 w-2 rounded-full bg-[#1a7f37]"></span>
              {t(ui as any, "index.hero.kicker")}
            </div>

            <!-- Display LG Headline: weight 400/500, never overly bold -->
            <h1 id="hero-heading" class="mt-5 text-[clamp(30px,6.5vw,50px)] font-normal leading-[1.12] tracking-tight text-[#24292f]">
              {t(ui as any, "index.hero.titleLine1")} <br class="hidden sm:inline" />
              <span class="text-[#24292f] font-medium">{t(ui as any, "index.hero.titleLine2")}</span>
            </h1>

            <p class="mt-5 max-w-[54ch] text-[16px] leading-[1.5] text-[#32383f]">
              LadeCompile is the quiet, enterprise-grade <strong class="font-medium text-[#24292f]">online code compiler</strong> for developers, students, and educators. Write HTML, CSS, and JavaScript in one tabbed editor and see your sandboxed live preview instantly — the clean <strong class="font-medium text-[#24292f]">OneCompiler alternative</strong> without the signup wall.
            </p>

            <p class="mt-3 max-w-[54ch] text-[14px] leading-relaxed text-[#656d76]">
              Part of the LadeStack suite of free developer tools. Prototype responsive layouts, debug JavaScript logic, or export standalone files in seconds.
            </p>

            <!-- Signature Button Pair -->
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a href={editorUrl} class="btn-primary">
                {t(ui as any, "index.hero.primaryCta")}
                <svg class="ml-2.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="#starters" class="btn-secondary">
                {t(ui as any, "index.hero.secondaryCta")}
              </a>
            </div>

            <p class="mt-3 text-[13px] text-[#656d76]">{t(ui as any, "index.hero.footnote")}</p>

            <!-- Trust Points -->
            <div class="mt-8 flex flex-wrap items-center gap-6 text-[13px] text-[#32383f] border-t border-[#d0d7de] pt-6">
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#1a7f37]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {t(ui as any, "index.hero.trust.sharing")}
              </span>
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#1a7f37]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {t(ui as any, "index.hero.trust.preview")}
              </span>
              <span class="inline-flex items-center gap-2">
                <svg class="h-4 w-4 text-[#1a7f37]" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {t(ui as any, "index.hero.trust.export")}
              </span>
            </div>
          </div>

          <!-- Code Snapshot Frame (Airtable-style clean editorial mockup) -->
          <div class="relative">
            <div class="overflow-hidden rounded-[12px] border border-[#d0d7de] bg-[#ffffff] shadow-sm">
              <!-- Window header -->
              <div class="flex items-center justify-between border-b border-[#d0d7de] bg-[#f6f8fa] px-4 py-2.5">
                <div class="flex items-center gap-2">
                  <span class="h-3 w-3 rounded-full bg-[#eaeef2] border border-[#d0d7de]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#eaeef2] border border-[#d0d7de]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#eaeef2] border border-[#d0d7de]"></span>
                </div>
                <div class="flex items-center gap-1.5 text-[12px]">
                  <span class="rounded-[6px] bg-[#ffffff] px-2.5 py-1 font-medium text-[#24292f] border border-[#d0d7de]">index.html</span>
                  <span class="px-2 py-1 text-[#656d76]">styles.css</span>
                  <span class="px-2 py-1 text-[#656d76]">script.js</span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] font-medium text-[#656d76]">
                  <span class="h-2 w-2 rounded-full bg-[#1a7f37]"></span> Live
                </div>
              </div>

              <!-- Editor & Preview Split -->
              <div class="grid gap-0 sm:grid-cols-2">
                <pre class="overflow-x-auto bg-[#ffffff] p-4 text-[12px] leading-relaxed text-[#333840] font-mono border-b sm:border-b-0 sm:border-r border-[#dddddd]"><code><span class="text-[#41454d]">&lt;!-- LadeCompile Live --&gt;</span>
<span class="text-[#1b61c9]">&lt;div</span> <span class="text-[#aa2d00]">class</span>=<span class="text-[#006400]">"card"</span><span class="text-[#1b61c9]">&gt;</span>
  <span class="text-[#1b61c9]">&lt;h2&gt;</span>Fast Prototyping<span class="text-[#1b61c9]">&lt;/h2&gt;</span>
  <span class="text-[#1b61c9]">&lt;p&gt;</span>Zero login. 400ms compile.<span class="text-[#1b61c9]">&lt;/p&gt;</span>
  <span class="text-[#1b61c9]">&lt;button</span> <span class="text-[#aa2d00]">id</span>=<span class="text-[#006400]">"action"</span><span class="text-[#1b61c9]">&gt;</span>
    Run Component
  <span class="text-[#1b61c9]">&lt;/button&gt;</span>
<span class="text-[#1b61c9]">&lt;/div&gt;</span></code></pre>

                <div class="bg-[#f6f8fa] p-4 flex flex-col justify-between">
                  <div class="rounded-[10px] border border-[#d0d7de] bg-[#ffffff] p-4">
                    <h3 class="text-[15px] font-medium text-[#24292f]">Fast Prototyping</h3>
                    <p class="mt-1 text-[13px] text-[#656d76]">Zero login. 400ms compile.</p>
                    <button class="mt-3 inline-flex items-center justify-center rounded-[6px] bg-[#24292f] px-3 py-1.5 text-[12px] font-medium text-white shadow-xs">
                      Run Component
                    </button>
                  </div>
                  <p class="mt-3 text-center text-[11px] text-[#656d76]">Sandboxed preview rendered at 60fps</p>
                </div>
              </div>

              <!-- Console status footer -->
              <div class="flex items-center justify-between border-t border-[#d0d7de] bg-[#ffffff] px-4 py-2 text-[12px] text-[#656d76]">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-[#24292f]">Console:</span>
                  <span class="text-[#1a7f37] font-medium">Ready</span> — 0 warnings, 0 errors
                </div>
                <span class="text-[11px] text-[#656d76]">PostMessage Bridge Active</span>
              </div>
            </div>
            <p class="mt-3 text-center text-[13px] text-[#656d76]">
              Looking for full Monaco code features? <a href={editorUrl} class="font-medium text-[#0969da] hover:underline">Open the complete web editor</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Monochrome Standards & Tech Strip: 32px padding, clean muted typography -->
    <section class="relative isolate overflow-hidden border-y border-[#d0d7de] bg-[#ffffff] py-8" aria-label="Supported Standards">
      <div class="relative z-content mx-auto max-w-[1280px] px-6 lg:px-12">
        <p class="text-center text-[13px] text-[#656d76]">
          {t(ui as any, "index.standards.label")}
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-8 sm:gap-12 text-[14px] font-medium text-[#32383f]">
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.html")}
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.css")}
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.ecma")}
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.monaco")}
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.sandbox")}
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#24292f]"></span>
            {t(ui as any, "index.standards.items.cloudflare")}
          </span>
        </div>
      </div>
    </section>

    <!-- Signature Coral Card: The brand voltage section from DESIGN.md -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]">
      <div class="relative z-content mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="relative isolate overflow-hidden rounded-[12px] bg-[#24292f] p-8 sm:p-12 lg:p-14 text-white shadow-sm">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div>
              <h2 class="text-[clamp(24px,5vw,36px)] font-normal leading-[1.2] tracking-tight text-white">
                {t(ui as any, "index.coral.title")}
              </h2>
              <p class="mt-4 text-[15px] sm:text-[16px] leading-[1.5] text-white/90">
                Stop wasting time registering accounts or hitting paywalls just to test an HTML snippet or experiment with a CSS trick. LadeCompile compiles your three files in a debounced, isolated worker bridge right in your client.
              </p>
              <div class="mt-8 flex flex-wrap items-center gap-4">
                <a href={editorUrl} class="btn-secondary-on-dark">
                  Launch Live Compiler
                  <svg class="ml-2 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Architectural Mockup inside Coral Card -->
            <div class="relative z-content rounded-[10px] border border-white/20 bg-white/10 p-6 backdrop-blur-sm text-white">
              <div class="flex items-center justify-between border-b border-white/20 pb-3 text-[12px] font-medium">
                <span>Compilation Pipeline</span>
                <span class="rounded bg-white/20 px-2 py-0.5 text-[11px]">400ms Debounce</span>
              </div>
              <div class="mt-4 space-y-3 text-[13px]">
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>1. Client Monaco Inputs (HTML/CSS/JS)</span>
                  <span class="text-white/80">Local-first</span>
                </div>
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>2. Sandbox Iframe PostMessage Bridge</span>
                  <span class="text-white/80">Isolated Origin</span>
                </div>
                <div class="flex items-center justify-between rounded-[8px] bg-white/10 px-3 py-2">
                  <span>3. Zero-Storage URL Hash Compression</span>
                  <span class="text-white/80">LZ-String</span>
                </div>
              </div>
              <p class="mt-4 text-[12px] text-white/80 text-center">
                High reliability · Zero tracking · Unblocked performance
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Demo-Card Grid (Pastel & Signature Surfaces): Mint, Peach, Forest, Cream -->
    <section id="features" class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="demo-grid-heading">
      <div class="relative z-content mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="max-w-2xl">
          <h2 id="demo-grid-heading" class="text-[clamp(24px,5vw,36px)] font-normal leading-[1.2] tracking-tight text-[#24292f]">
            Every feature you need — none of the paywalls.
          </h2>
          <p class="mt-3 text-[16px] leading-[1.5] text-[#32383f]">
            A focused developer workbench that eliminates the friction of traditional web playgrounds.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1: Editor-neutral surface -->
          <article class="rounded-[10px] border border-[#d0d7de] bg-[#ffffff] p-6 text-[#24292f] flex flex-col justify-between shadow-xs">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#24292f]/70">Zero-Storage Sharing</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#24292f]">Instant State Compression</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#24292f]/90">
                Your code is compressed straight into the browser URL hash using LZ-String. Share snippets with colleagues without creating an account or sending data to a database.
              </p>
            </div>
            <div class="mt-6 rounded-[8px] border border-[#24292f]/15 bg-white/70 p-3 text-[12px] font-mono text-[#24292f]">
              compile.ladestack.in/#code=H4sIAAAAAAA...
            </div>
          </article>

          <!-- Card 2: Editor-neutral surface -->
          <article class="rounded-[10px] border border-[#d0d7de] bg-[#ffffff] p-6 text-[#24292f] flex flex-col justify-between shadow-xs">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#24292f]/70">Export Suite</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#24292f]">ZIP, HTML & Screenshot</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#24292f]/90">
                Download your HTML, CSS, and JS bundle as a ready-to-deploy ZIP, copy standalone single-file HTML, or snap a crisp high-res screenshot of your rendered UI.
              </p>
            </div>
            <div class="mt-6 flex gap-2">
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#24292f]">.ZIP</span>
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#24292f]">HTML</span>
              <span class="rounded-[6px] bg-white/80 px-2.5 py-1 text-[11px] font-semibold text-[#24292f]">PNG</span>
            </div>
          </article>

          <!-- Card 3: Forest Signature Card (#24292f) -->
          <article class="relative isolate overflow-hidden rounded-[12px] bg-[#24292f] p-6 text-white flex flex-col justify-between shadow-xs lg:row-span-2">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-white/70">{t(ui as any, "index.standards.items.monaco")}</span>
              <h3 class="mt-2 text-[22px] font-medium leading-snug text-white">VS Code Precision in Your Browser</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-white/90">
                Built on Monaco Editor, LadeCompile provides native syntax highlighting, intelligent indentation, code formatting, find-and-replace, and native keyboard shortcuts.
              </p>

              <div class="mt-6 space-y-2.5">
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Save / Compile</span>
                  <kbd class="rounded bg-white/20 px-1.5 py-0.5 text-[10px] font-mono">Cmd/Ctrl + S</kbd>
                </div>
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Find & Replace</span>
                  <kbd class="rounded bg-white/20 px-1.5 py-0.5 text-[10px] font-mono">Cmd/Ctrl + F</kbd>
                </div>
                <div class="flex items-center justify-between rounded-[6px] bg-white/10 px-3 py-2 text-[12px]">
                  <span>Toggle Minimap</span>
                  <span class="text-white/70 text-[11px]">Preferences Menu</span>
                </div>
              </div>
            </div>

            <div class="mt-6 border-t border-white/20 pt-4">
              <a href={editorUrl} class="inline-flex items-center text-[13px] font-medium text-white hover:underline">
                Test in editor →
              </a>
            </div>
          </article>

          <!-- Card 4: Editor-neutral subtle surface -->
          <article class="rounded-[10px] border border-[#d0d7de] bg-[#f6f8fa] p-6 text-[#24292f] flex flex-col justify-between shadow-xs md:col-span-2 lg:col-span-2">
            <div>
              <span class="text-[12px] font-semibold uppercase tracking-wider text-[#24292f]/70">Curated Starters</span>
              <h3 class="mt-2 text-[20px] font-medium leading-snug text-[#24292f]">10 Production-Grade Starter Boilerplates</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-[#24292f]/90">
                Start from a blank canvas or choose from verified templates: modern CSS Grid dashboards, responsive landing pages, interactive forms with client validation, dark mode cards, HTML5 canvas animations, and weather API widgets.
              </p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="rounded-[6px] border border-[#24292f]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#24292f]">CSS Grid</span>
              <span class="rounded-[6px] border border-[#24292f]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#24292f]">Flexbox Hero</span>
              <span class="rounded-[6px] border border-[#24292f]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#24292f]">Canvas Animation</span>
              <span class="rounded-[6px] border border-[#24292f]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#24292f]">Fetch API Weather</span>
              <span class="rounded-[6px] border border-[#24292f]/10 bg-white/80 px-2.5 py-1 text-[12px] font-medium text-[#24292f]">Form Validation</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Tabbed Feature Showcase: feature-card-tabbed from DESIGN.md -->
    <section class="relative isolate overflow-hidden py-16 sm:py-24 bg-[#ffffff]" aria-labelledby="workflow-heading">
      <div class="relative z-content mx-auto max-w-[1280px] px-6 lg:px-12">
        <div class="max-w-2xl">
          <h2 id="workflow-heading" class="text-[clamp(24px,5vw,36px)] font-normal leading-[1.2] tracking-tight text-[#24292f]">
            {t(ui as any, "index.tabbed.heading")}
          </h2>
          <p class="mt-3 text-[16px] leading-[1.5] text-[#32383f]">
            Explore how each part of LadeCompile fits together to give you a clean, reliable coding workflow.
          </p>
        </div>

        <div class="mt-12 rounded-[12px] border border-[#d0d7de] bg-[#f6f8fa] p-6 sm:p-10">
          <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-center">
            <!-- Left Tab Navigation — unnumbered feature list (independent features, not sequential steps) -->
            <div class="flex flex-col gap-2" role="tablist" aria-label="Feature Tabs">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                class="tab-btn text-left rounded-[10px] border border-[#d0d7de] bg-white p-4 transition-all"
                data-tab="tab-1"
              >
                <div class="flex items-center gap-2 text-[16px] font-medium text-[#24292f]">
                  <svg class="h-4 w-4 shrink-0 text-[#0969da]" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 3.5H10.5L12 5V12.5H4V3.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M10.5 3.5V5H12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6 8H10M6 10.5H10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  Three-File Harmony
                </div>
                <div class="mt-1 text-[13px] text-[#656d76]">Independent HTML, CSS, and JS tabs with automatic syntax formatting.</div>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="tab-btn text-left rounded-[10px] border border-transparent hover:border-[#d0d7de] bg-transparent p-4 transition-all"
                data-tab="tab-2"
              >
                <div class="flex items-center gap-2 text-[16px] font-medium text-[#24292f]">
                  <svg class="h-4 w-4 shrink-0 text-[#0969da]" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="4" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 7.5L6.5 9L8.5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 7V9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  Sandboxed Console Bridge
                </div>
                <div class="mt-1 text-[13px] text-[#656d76]">Live postMessage error and log forwarding with unread count badges.</div>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="tab-btn text-left rounded-[10px] border border-transparent hover:border-[#d0d7de] bg-transparent p-4 transition-all"
                data-tab="tab-3"
              >
                <div class="flex items-center gap-2 text-[16px] font-medium text-[#24292f]">
                  <svg class="h-4 w-4 shrink-0 text-[#0969da]" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5.5H13V11.5C13 12.3 12.3 13 11.5 13H4.5C3.67 13 3 12.3 3 11.5V5.5Z" stroke="currentColor" stroke-width="1.3"/><path d="M3 5.5C3 4.67 3.67 4 4.5 4H11.5C12.3 4 13 4.67 13 5.5" stroke="currentColor" stroke-width="1.3"/><circle cx="8" cy="8.5" r="1" fill="currentColor"/></svg>
                  Local-First Storage
                </div>
                <div class="mt-1 text-[13px] text-[#656d76]">Changes persist automatically in localStorage; work survives reloads.</div>
