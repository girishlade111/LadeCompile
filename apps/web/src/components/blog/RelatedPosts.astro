---
import type { BlogPost } from "../../utils/blog";
import { getRelatedPosts } from "../../utils/blog";
import BlogCard from "./BlogCard.astro";

interface Props {
  currentPost: BlogPost;
  allPosts: BlogPost[];
  limit?: number;
}

const { currentPost, allPosts, limit = 2 } = Astro.props;
const relatedPosts = getRelatedPosts(currentPost, allPosts, limit);
---

{relatedPosts.length > 0 && (
  <section class="relative isolate overflow-hidden mt-16 border-t border-[#d0d7de] pt-12" aria-labelledby="related-posts-heading">
    <div class="relative z-content mb-6 flex items-center justify-between">
      <div>
        <h2 id="related-posts-heading" class="text-[22px] font-medium tracking-tight text-[#24292f]">
          Related Articles
        </h2>
      </div>
      <a href={localePath(normalizeLocale((Astro.currentLocale as string) ?? "en"), "/blog")} class="text-[13px] font-medium text-[#0969da] hover:underline">
        All articles →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {relatedPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
)}
