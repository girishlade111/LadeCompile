---
import type { BlogPost } from "../../utils/blog";
import BlogCard from "./BlogCard.astro";

interface Props {
  posts: BlogPost[];
  showFeaturedFirst?: boolean;
}

const { posts, showFeaturedFirst = true } = Astro.props;

// If showFeaturedFirst is true and we have at least one post marked featured, highlight it
const featuredPost = showFeaturedFirst ? posts.find((p) => p.data.featured) : undefined;
const regularPosts = featuredPost
  ? posts.filter((p) => p.id !== featuredPost.id)
  : posts;
---

<div class="relative isolate space-y-8">
  {featuredPost && (
    <div class="relative isolate overflow-hidden mb-10">
      <div class="relative z-10 mb-3 flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full bg-[#1a7f37]" />
        <span class="text-[13px] font-medium text-[#656d76]">Featured story</span>
      </div>
      <div class="relative z-10">
        <BlogCard post={featuredPost} featured={true} />
      </div>
    </div>
  )}

  {regularPosts.length === 0 && !featuredPost ? (
    <div class="rounded-[12px] border border-[#d0d7de] bg-[#f6f8fa] p-12 text-center">
      <p class="text-[15px] font-medium text-[#24292f]">No articles found</p>
      <p class="mt-1 text-[13px] text-[#656d76]">Check back soon for new guides and deep-dives.</p>
    </div>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {regularPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  )}
</div>
