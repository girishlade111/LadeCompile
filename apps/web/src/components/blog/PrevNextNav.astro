---
import type { BlogPost } from "../../utils/blog";
import { getPostSlug } from "../../utils/blog";
import { normalizeLocale, localePath } from "../../i18n/locales";

interface Props {
  prevPost?: BlogPost;
  nextPost?: BlogPost;
}

const { prevPost, nextPost } = Astro.props;
const locale = normalizeLocale((Astro.currentLocale as string) ?? "en");
---

{(prevPost || nextPost) && (
  <nav aria-label="Article navigation" class="my-10 grid gap-4 sm:grid-cols-2 border-t border-[#d0d7de] pt-8">
    {prevPost ? (
      <a
        href={localePath(locale, `/blog/${getPostSlug(prevPost)}/`)}
        class="group flex flex-col justify-between rounded-[10px] border border-[#d0d7de] bg-[#ffffff] p-5 text-left transition-colors hover:border-[#24292f]/40 hover:bg-[#f6f8fa]"
      >
        <span class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[#656d76] group-hover:text-[#24292f]">
          <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Previous Article
        </span>
        <span class="mt-2 text-[15px] font-medium leading-snug text-[#24292f] group-hover:text-[#0969da] line-clamp-2">
          {prevPost.data.title}
        </span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )}

    {nextPost ? (
      <a
        href={localePath(locale, `/blog/${getPostSlug(nextPost)}/`)}
        class="group flex flex-col justify-between rounded-[10px] border border-[#d0d7de] bg-[#ffffff] p-5 text-right transition-colors hover:border-[#24292f]/40 hover:bg-[#f6f8fa]"
      >
        <span class="inline-flex items-center justify-end gap-1.5 text-[12px] font-medium text-[#656d76] group-hover:text-[#24292f]">
          Next Article
          <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="mt-2 text-[15px] font-medium leading-snug text-[#24292f] group-hover:text-[#0969da] line-clamp-2">
          {nextPost.data.title}
        </span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )}
  </nav>
)}
