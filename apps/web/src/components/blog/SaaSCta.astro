---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}

const {
  title = "Try LadeCompile live — no account required",
  description = "Write HTML, CSS, and JavaScript in an isolated sandbox with instant preview, console output, and one-click share links. 100% free, zero signup friction.",
  buttonText = "Open Free Web Editor",
} = Astro.props;

import { normalizeLocale, localePath } from "../../i18n/locales";
const locale = normalizeLocale((Astro.currentLocale as string) ?? "en");
const editorUrl = localePath(locale,
  import.meta.env.PUBLIC_EDITOR_URL ||
  (import.meta.env.DEV ? "http://localhost:3000/editor" : "/editor"));
---

<div class="relative isolate overflow-hidden my-12 rounded-[12px] border border-[#d0d7de] bg-[#f6f8fa] p-7 sm:p-8 text-[#24292f]">
  <div class="relative z-content flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="max-w-xl">
      <div class="inline-flex items-center gap-2 rounded-[4px] bg-[#ddf4ff] border border-[#0969da]/20 px-2 py-0.5 text-[11px] font-medium text-[#0969da]">
        Zero friction tool
      </div>
      <h3 class="mt-2 text-[20px] sm:text-[22px] font-medium leading-snug tracking-tight text-[#24292f]">
        {title}
      </h3>
      <p class="mt-2 text-[14px] leading-relaxed text-[#32383f]">
        {description}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row gap-3 shrink-0">
      <a
        href={editorUrl}
        class="inline-flex items-center justify-center rounded-[12px] bg-[#24292f] px-5 py-3 text-[14px] font-medium text-white shadow-sm hover:bg-[#0d1218] transition-colors"
      >
        {buttonText}
        <svg class="ml-2 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        href={localePath(locale, "/#starters")}
        class="inline-flex items-center justify-center rounded-[12px] border border-[#24292f]/20 bg-white/70 px-4 py-3 text-[14px] font-medium text-[#24292f] hover:bg-white transition-colors"
      >
        Browse Templates
      </a>
    </div>
  </div>
</div>
