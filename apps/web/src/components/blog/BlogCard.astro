---
import type { BlogPost } from "../../utils/blog";
import { getPostSlug, formatBlogDate, calculateReadingTime } from "../../utils/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const slug = getPostSlug(post);
const postUrl = `/blog/${slug}/`;
const readingTime = calculateReadingTime(post.body);
const date = post.data.pubDate ?? post.data.publishDate ?? new Date();
const image = post.data.image ?? post.data.heroImage;
---

<article
  class={`group relative flex flex-col rounded-[12px] border border-[#dddddd] bg-[#ffffff] transition-all duration-200 hover:border-[#181d26]/40 hover:shadow-sm overflow-hidden ${
    featured ? "lg:grid lg:grid-cols-12 lg:gap-8 p-6 sm:p-8 bg-gradient-to-br from-[#ffffff] to-[#f8fafc]" : "p-6 sm:p-7"
  }`}
>
  {image && (
    <div class={`${featured ? "lg:col-span-5 mb-5 lg:mb-0" : "mb-5"} overflow-hidden rounded-[8px] border border-[#dddddd]/70 bg-[#f8fafc]`}>
      <a href={postUrl} tabindex="-1" aria-hidden="true" class="block aspect-[16/9] w-full overflow-hidden">
        <img
          src={image}
          alt={post.data.imageAlt || post.data.title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </a>
    </div>
  )}

  <div class={`flex flex-1 flex-col justify-between ${featured ? (image ? "lg:col-span-7" : "lg:col-span-12") : ""}`}>
    <div>
      <div class="flex flex-wrap items-center gap-2 text-[12px] text-[#41454d]">
        {post.data.category && (
          <span class="rounded-[4px] border border-[#aa2d00]/20 bg-[#aa2d00]/5 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#aa2d00]">
            {post.data.category}
          </span>
        )}
        <time datetime={date.toISOString()} class="font-medium text-[#181d26]">
          {formatBlogDate(date)}
        </time>
        <span class="text-[#dddddd]">·</span>
        <span class="text-[#41454d]">{readingTime}</span>
      </div>

      <h3 class={`mt-3 font-normal leading-snug tracking-tight text-[#181d26] group-hover:text-[#1b61c9] transition-colors ${
        featured ? "text-[24px] sm:text-[28px]" : "text-[20px]"
      }`}>
        <a href={postUrl} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true" />
          {post.data.title}
        </a>
      </h3>

      <p class="mt-2.5 text-[14px] leading-relaxed text-[#333840] line-clamp-3">
        {post.data.description}
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[#dddddd]/60 pt-4 text-[12px] text-[#41454d]">
      <div class="inline-flex items-center gap-1.5 font-medium text-[#181d26]">
        <span>{post.data.author || "LadeStack Team"}</span>
      </div>

      <div class="relative z-10 flex items-center gap-1 font-medium text-[#1b61c9] group-hover:translate-x-0.5 transition-transform">
        <span>Read article</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </div>
</article>
