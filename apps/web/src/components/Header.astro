<header class="sticky top-0 z-40 w-full border-b border-[#dddddd] bg-[#ffffff]">
  <div class="mx-auto flex h-16 max-w-[1280px] items-center justify-between px-6 lg:px-12">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5" aria-label="LadeCompile home">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-[6px] bg-[#181d26] text-[12px] font-bold tracking-wider text-white">LC</span>
        <span class="text-[16px] font-medium tracking-tight text-[#181d26]">LadeCompile</span>
        <span class="hidden rounded-[4px] border border-[#dddddd] bg-[#f8fafc] px-2 py-0.5 text-[10px] font-semibold tracking-widest text-[#41454d] sm:inline-flex">LADESTACK</span>
      </a>

      <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
        <a href="/#features" class="text-[14px] font-normal text-[#333840] hover:text-[#181d26] transition-colors">Features</a>
        <a href="/#starters" class="text-[14px] font-normal text-[#333840] hover:text-[#181d26] transition-colors">Templates</a>
        <a href="/#comparison" class="text-[14px] font-normal text-[#333840] hover:text-[#181d26] transition-colors">Comparison</a>
        <a href="/blog" class="text-[14px] font-normal text-[#333840] hover:text-[#181d26] transition-colors">Blog</a>
