    <div class="flex items-center gap-3">
      <a href="/blog" class="md:hidden text-[14px] font-medium text-[#333840] px-2 py-1">Blog</a>
      <a href="/#starters" class="hidden sm:inline-flex items-center justify-center rounded-[12px] border border-[#dddddd] bg-[#ffffff] px-4 py-2 text-[14px] font-medium text-[#181d26] hover:bg-[#f8fafc] transition-colors">
        Templates
      </a>
      <a href="/editor" class="inline-flex items-center justify-center rounded-[12px] bg-[#181d26] px-5 py-2 text-[14px] font-medium text-white hover:bg-[#0d1218] transition-colors shadow-sm">
        Open Editor
      </a>
    </div>
  </div>
</header>
