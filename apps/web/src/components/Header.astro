---
const editorUrl = import.meta.env.PUBLIC_EDITOR_URL || (import.meta.env.DEV ? "http://localhost:3000/editor" : "/editor");
---
<header class="sticky top-0 z-40 w-full border-b border-[#d0d7de] bg-[#ffffff]">
  <div class="mx-auto flex h-16 max-w-[1280px] items-center justify-between px-6 lg:px-12">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5" aria-label="LadeCompile home">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-[6px] bg-[#24292f] text-[12px] font-bold tracking-wider text-white">LC</span>
        <span class="text-[16px] font-medium tracking-tight text-[#24292f]">LadeCompile</span>
        <span class="hidden rounded-[4px] border border-[#d0d7de] bg-[#f6f8fa] px-2 py-0.5 text-[10px] font-semibold tracking-widest text-[#656d76] sm:inline-flex">LADESTACK</span>
      </a>

      <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
        <a href="/#features" class="text-[14px] font-normal text-[#32383f] hover:text-[#24292f] transition-colors">Features</a>
        <a href="/#starters" class="text-[14px] font-normal text-[#32383f] hover:text-[#24292f] transition-colors">Templates</a>
        <a href="/#comparison" class="text-[14px] font-normal text-[#32383f] hover:text-[#24292f] transition-colors">Comparison</a>
        <a href="/blog" class="text-[14px] font-normal text-[#32383f] hover:text-[#24292f] transition-colors">Blog</a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a href="/blog" class="md:hidden text-[14px] font-medium text-[#32383f] px-2 py-1">Blog</a>
      <a href="/#starters" class="hidden sm:inline-flex items-center justify-center rounded-[12px] border border-[#d0d7de] bg-[#ffffff] px-4 py-2 text-[14px] font-medium text-[#24292f] hover:bg-[#f6f8fa] transition-colors">
        Templates
      </a>
      <a href={editorUrl} class="inline-flex items-center justify-center rounded-[12px] bg-[#24292f] px-5 py-2 text-[14px] font-medium text-white hover:bg-[#0d1218] transition-colors shadow-sm">
        Open Editor
      </a>
    </div>
  </div>
</header>
