---
/**
 * Reusable SEO / Head component using Astro native head management.
 * Renders title, meta description, canonical, Open Graph, and Twitter Card tags per page.
 */
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  locale?: string;
}

const {
  title = "LadeCompile — Free HTML CSS JS Online Compiler, No Login Required",
  description = "Free, no-login, enterprise-grade HTML/CSS/JS online compiler and live editor. Write, run, and share code instantly — no signup, no paywall. The fast OneCompiler alternative from LadeStack.",
  canonical,
  image = "/favicon.svg",
  imageAlt = "LadeCompile — free HTML CSS JS compiler",
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  author = "LadeStack",
  tags = [],
  locale: localeProp,
} = Astro.props as Props;

const site = Astro.site?.toString() ?? "https://compile.ladestack.in";
const resolvedLocale = (localeProp ?? (Astro.currentLocale as string) ?? "en").toLowerCase();
const LOCALE_BCP47: Record<string, string> = {
  en: "en",
  zh: "zh",
  "pt-br": "pt-BR",
  ru: "ru",
  ja: "ja",
  tr: "tr",
  ko: "ko",
};
const OG_LOCALE: Record<string, string> = {
  en: "en_US",
  zh: "zh_CN",
  "pt-br": "pt_BR",
  ru: "ru_RU",
  ja: "ja_JP",
  tr: "tr_TR",
  ko: "ko_KR",
};
const canonicalURL = canonical ?? new URL(Astro.url.pathname, site).href;
const imageURL = image.startsWith("http") ? image : new URL(image, site).href;
const siteName = "LadeCompile";
const ogLocale = OG_LOCALE[resolvedLocale] ?? "en_US";

// Build pathWithoutLocale for hreflang generation
const SUPPORTED = ["en", "zh", "pt-br", "ru", "ja", "tr", "ko"];
const rawPath = Astro.url.pathname;
const firstSeg = rawPath.split("/").filter(Boolean)[0]?.toLowerCase();
const hasLocalePrefix = firstSeg ? SUPPORTED.includes(firstSeg) : false;
const pathWithoutLocale = hasLocalePrefix ? "/" + rawPath.split("/").slice(2).join("/") || "/" : rawPath;
const normalizedPathWithoutLocale = pathWithoutLocale === "" ? "/" : pathWithoutLocale;
function localeHref(loc: string) {
  if (loc === "en") return new URL(normalizedPathWithoutLocale, site).href;
  return new URL(`/${loc}${normalizedPathWithoutLocale}`, site).href;
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={type} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={ogLocale} />

<!-- hreflang alternates: 7 locales + x-default — omitted on noindex fallback pages to avoid indexing duplicate English content under locale URLs -->
{!noindex && SUPPORTED.map((loc) => (
  <link rel="alternate" hreflang={LOCALE_BCP47[loc] ?? loc} href={localeHref(loc)} />
))}
{!noindex && <link rel="alternate" hreflang="x-default" href={localeHref("en")} />}

{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === "article" && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === "article" && author && (
  <meta property="article:author" content={author} />
)}
{type === "article" && tags && tags.map((t) => (
  <meta property="article:tag" content={t} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Additional discoverability -->
<meta name="theme-color" content="#6366f1" />
<link rel="sitemap" href="/sitemap-index.xml" />
